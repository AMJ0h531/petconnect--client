# .env  (local development)
# WHY VITE_ prefix: only variables starting with VITE_ are exposed to the browser
# Never put secrets here — this file is public in the browser bundle
VITE_API_URL=http://localhost:8080/api

# .env.production  (used when AWS CodeBuild runs "vite build")
# Replace with your actual EC2 public URL before deploying
VITE_API_URL=http://your-ec2-ip:8080/api