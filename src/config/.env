# PetConnect+ Backend — Environment Variables
# This file is read automatically when you run: npm start

# ── Server ──────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:8081

# ── Email Provider ───────────────────────────
# For the capstone prototype, emails are simulated in the browser.
# Fill these in only if you want real emails to send.
#
# Gmail option:
EMAIL_PROVIDER=gmail
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-16-char-app-password
EMAIL_FROM="PetConnect+ <your-gmail@gmail.com>"
